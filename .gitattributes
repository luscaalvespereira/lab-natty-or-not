# Configuração do GitHub Linguist
# Elimina HTML das estatísticas para manter a apresentação profissional de engenharia de software
# Exibe o ecossistema poliglota completo: JavaScript, Python, CSS e Shell

# Oculta completamente o HTML estático
*.html -linguist-detectable
*.html linguist-vendored
*.html linguist-documentation
index.html -linguist-detectable
index.html linguist-vendored

# Mantém CSS detectável (Design & Estilização da Interface)
styles/main.css linguist-detectable

# Mantém Python detectável (Data Science & Ferramenta Forense CLI)
scripts/forensic_cli.py linguist-detectable

# Mantém Shell detectável (DevOps & Automação CI)
scripts/verify-integrity.sh linguist-detectable
